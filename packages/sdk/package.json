{
  "name": "@keyset/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the Keyset direct-booking API.",
  "license": "MIT",
  "homepage": "https://keyset.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keysethq/keyset-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/keysethq/keyset-js/issues"
  },
  "keywords": [
    "keyset",
    "booking",
    "accommodation",
    "direct-booking",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": null,
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERSIONING.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  }
}
