{
  "name": "keyset-js",
  "private": true,
  "type": "module",
  "description": "Public mirror of the Keyset TypeScript SDK and CLI. The source of truth is private.",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.1 <2",
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun test ./packages",
    "sdk:pack": "node scripts/pack-sdk.mjs",
    "cli:pack": "node scripts/pack-cli.mjs",
    "sdk:publint": "publint",
    "sdk:attw": "attw --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "24.19.2",
    "bun-types": "1.4.4",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  }
}
